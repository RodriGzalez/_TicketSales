FROM php:8.3-apache

# Instalar dependencias del sistema y extensiones de PHP
RUN apt-get update && apt-get install -y \
    git \
    curl \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    zip \
    unzip

# Instalar Node.js LTS
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs

RUN docker-php-ext-install pdo_mysql mbstring exif pcntl bcmath gd

# Copiar Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Copiar primero solo los archivos de dependencias para aprovechar la caché de Docker
COPY composer.json composer.lock package.json package-lock.json ./

# Instalar dependencias de PHP y Node de forma independiente
RUN composer install --no-dev --optimize-autoloader
RUN npm install

# Copiar el resto del código fuente del proyecto
COPY . /var/www/html

# Compilar los assets con Vite asegurando la URL de producción
RUN npm run build

RUN npm run dev

# Permisos y configuración de Apache
RUN chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache

RUN sed -i 's|DocumentRoot /var/www/html|DocumentRoot /var/www/html/public|g' /etc/apache2/sites-available/000-default.conf
RUN echo '<Directory /var/www/html/public>\n\tAllowOverride All\n\tRequire all granted\n</Directory>' >> /etc/apache2/sites-available/000-default.conf

RUN a2enmod rewrite

EXPOSE 80